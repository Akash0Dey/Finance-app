# Local development. Owner credentials are created with npm run setup-owner.
HOST=127.0.0.1
PORT=3001

# Online deployment: set these in your hosting provider's environment settings.
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-domain.example
# TRUST_PROXY_HOPS=1
# DATABASE_PATH=/absolute/path/on/persistent-volume/pocket.sqlite
# Only trust the actual number of reverse proxy hops. Block direct public access
# to the Node port, so clients cannot spoof proxy headers. HTTPS is mandatory.