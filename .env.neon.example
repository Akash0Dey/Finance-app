# Copy this file to .env.neon and replace the placeholder privately.
# .env.neon is ignored by Git. Never paste its contents into chat.
# Used by npm run setup-owner:neon from your own computer; no Render shell needed.
# Copy the full pooled connection string from Neon, including SSL parameters.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require